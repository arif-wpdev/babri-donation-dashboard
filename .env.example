# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in real values. NEVER commit the filled file.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → Database → Connection string
# Newer projects: use the POOLER host for both URLs (db.<ref>.supabase.co is
# IPv6-only and will not resolve). The project-scoped username
# (postgres.<project-ref>) is required.
# Encode special characters in the password: # -> %23  $ -> %24  ^ -> %5E
#
# DATABASE_URL is OPTIONAL. Leave it unset and use the DB_* parts below when
# the host mangles percent-encoded values (Vercel does this, which silently
# breaks passwords containing $ or ^).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Used at runtime only when DATABASE_URL is absent. The password is passed
# through verbatim, so no URL encoding is involved.
# DB_URL      = aws-0-<region>.pooler.supabase.com:6543
# DB_USER     = postgres.<project-ref>
# DB_PASSWORD = <raw password, not encoded>
# DB_NAME     = postgres

# Auth.js — openssl rand -base64 32
AUTH_SECRET=""

# 32 random bytes, hex encoded — openssl rand -hex 32
# Encrypts stored WooCommerce credentials. Changing it makes existing
# encrypted values unreadable, so keep it stable once data exists.
ENCRYPTION_KEY=""

# Used to authenticate /api/cron/* requests
CRON_SECRET=""

# Public base URL of this deployment (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Super Admin created by `npm run db:seed`
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""

# Authentication hardening rollout. Keep disabled until delivery/origin settings
# are configured and verified; then set AUTH_MFA_ENABLED=true.
AUTH_MFA_ENABLED="false"
AUTH_MFA_CONFIGURED="false"
AUTH_APP_ORIGIN="https://your-app.example.org"
AUTH_WEBAUTHN_RP_ID="your-app.example.org"
AUTH_WEBAUTHN_RP_NAME="Donation Dashboard"
# Use independent random secrets (at least 32 chars) in deployment secret storage.
AUTH_OTP_HASH_KEY=""
AUTH_RATE_LIMIT_HMAC_KEY=""
AUTH_DUMMY_PASSWORD_HASH=""

# Greenweb / BD Bulk SMS API token for verified-phone OTP delivery.
# Generate an API token in the Greenweb SMS portal and store it only in the
# deployment's server-side secret manager. Never expose it to the browser.
GREENWEB_SMS_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: keep DATABASE_URL, DIRECT_URL, SEED_SUPER_ADMIN_EMAIL and
# SEED_SUPER_ADMIN_PASSWORD identical in .env and .env.local.
#   - `dotenv/config` (prisma.config.ts, seed.ts) reads ONLY .env
#   - Next.js reads .env.local first
# If they disagree, the CLI and the running app use different credentials.
# ─────────────────────────────────────────────────────────────────────────────
