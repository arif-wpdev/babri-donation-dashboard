// Donation Insight — Prisma Schema
// Multi-tenant SaaS: Organizations → Funds (WC Products), Donors (WC Customers), Donations (WC Orders)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_USER
}

enum DonationStatus {
  PENDING
  PROCESSING
  ON_HOLD
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
  TRASH
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum SyncTrigger {
  MANUAL
  CRON
}

enum AdLedgerEntryType {
  TOP_UP
  SPEND
}

enum AdLedgerEntryStatus {
  POSTED
  VOID
}

enum AdLedgerEntrySource {
  MANUAL
  IMPORT
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION — Top-level tenant
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique /// URL-safe identifier used in routing

  logoUrl String?

  /// WooCommerce connection — encrypted at rest via Prisma middleware
  wcBaseUrl        String
  wcConsumerKey    String
  wcConsumerSecret String
  wcWebhookSecret  String?

  /// Custom Donation Plugin connection
  tdfApiKey        String?
  tdfWebhookSecret String?

  syncEnabled  Boolean   @default(true)
  syncInterval Int       @default(360) /// Minutes between automatic syncs
  lastSyncedAt DateTime?

  /// Daily donor backup configuration; provider secrets are encrypted with AES-256-GCM.
  donorBackupEnabled             Boolean   @default(false)
  donorBackupGoogleDriveEnabled  Boolean   @default(false)
  donorBackupGoogleDriveFolderId String?
  donorBackupGoogleCredentials   String?
  donorBackupB2Enabled            Boolean   @default(false)
  donorBackupB2Endpoint           String?
  donorBackupB2Bucket             String?
  donorBackupB2KeyId               String?
  donorBackupB2ApplicationKey       String?
  donorBackupLastRunAt              DateTime?
  donorBackupLastStatus             String?
  donorBackupLastError              String?   @db.Text
  donorBackupLastCount               Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? /// Soft delete — null = active

  // Relations
  users     User[]
  funds     Fund[]
  donors    Donor[]
  donations Donation[]
  syncLogs  SyncLog[]
  adLedgerEntries      AdLedgerEntry[]
  adSpendImportBatches AdSpendImportBatch[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER — Platform users; SUPER_ADMIN has no org; ORG_ADMIN belongs to one org
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  phone         String?   @unique
  phoneVerifiedAt DateTime?
  passwordChangedAt DateTime @default(now())
  emailVerified DateTime?
  image         String?
  passwordHash  String? /// Null when using OAuth only

  role Role @default(ORG_ADMIN)

  /// Null for SUPER_ADMIN; required for ORG_ADMIN
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  disabledAt DateTime?

  // NextAuth adapter relations
  accounts Account[]
  sessions Session[]
  webAuthnCredentials WebAuthnCredential[]
  trustedDevices TrustedDevice[]
  authChallenges AuthChallenge[]
  securityEvents SecurityEvent[]
  authSessions AuthSession[]
  loginTickets LoginTicket[]
  loginPreAuth LoginPreAuth[]
  recoveryCodes AuthRecoveryCode[]
  adLedgerEntriesCreated AdLedgerEntry[]      @relation("AdLedgerEntryCreator")
  adSpendImportBatches   AdSpendImportBatch[] @relation("AdSpendImportBatchImporter")

  @@map("users")
}

enum AuthChallengeType {
  OTP
  PHONE_VERIFICATION
  PASSWORD_RESET
  PASSKEY_REGISTRATION
  PASSKEY_AUTHENTICATION
}

enum AuthEventType {
  LOGIN_SUCCESS
  PASSWORD_FAILURE
  OTP_FAILURE
  OTP_LOCK
  OTP_SENT
  PASSKEY_REGISTERED
  PASSKEY_LOGIN_SUCCESS
  DEVICE_REVOKED
  LOGOUT
  PASSWORD_CHANGED
  NEW_DEVICE
  SUSPICIOUS_ACTIVITY
  OTP_REQUESTED
  PASSWORD_RESET
  PHONE_VERIFICATION
}

model AuthRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, usedAt])
  @@map("auth_recovery_codes")
}

model AuthChallenge {
  id               String            @id @default(cuid())
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifierHash   String
  type             AuthChallengeType
  otpHash          String?
  challenge        String?
  purpose          String?
  loginTicketHash  String?
  loginTicketExpiresAt DateTime?
  failedAttempts   Int               @default(0)
  lockedUntil      DateTime?
  otpCreatedAt     DateTime?
  otpExpiresAt     DateTime?
  verifiedAt       DateTime?
  consumedAt       DateTime?
  deliveryChannel  String?
  resendAfter      DateTime?
  ipHash           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([identifierHash, type, createdAt])
  @@index([userId, type, createdAt])
  @@unique([identifierHash, type])
  @@map("auth_challenges")
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  mobileLockEnabled Boolean @default(false)
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model LoginTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preauthId String?
  preauth LoginPreAuth? @relation(fields: [preauthId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("login_tickets")
}

model LoginPreAuth {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets    LoginTicket[]
  tokenHash  String   @unique
  deliveryChannel String?
  passkeyOnly Boolean @default(false)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("login_pre_auth")
}

model WebAuthnCredential {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId       String    @unique
  publicKey          String    @db.Text
  counter            BigInt    @default(0)
  transports         String[]  @default([])
  deviceType         String?
  backedUp           Boolean   @default(false)
  deviceName         String
  credentialDeviceId String
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  trustedDevices     TrustedDevice[]

  @@index([userId, revokedAt])
  @@map("webauthn_credentials")
}

model TrustedDevice {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String
  credential   WebAuthnCredential @relation(fields: [credentialId], references: [credentialId], onDelete: Cascade)
  tokenHash    String            @unique
  deviceType   String?
  createdAt    DateTime          @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  @@index([userId, revokedAt])
  @@map("trusted_devices")
}

model SecurityEvent {
  id         String       @id @default(cuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType  AuthEventType
  ipHash     String?
  userAgent  String?      @db.VarChar(512)
  deviceId   String?
  details    Json?
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

model AuthRateLimit {
  key        String   @id
  count      Int      @default(0)
  windowEnds DateTime
  blockedUntil DateTime?
  updatedAt  DateTime @updatedAt

  @@index([windowEnds])
  @@map("auth_rate_limits")
}

// ─────────────────────────────────────────────────────────────────────────────
// FUND — Mirrors a WooCommerce Product (donation fund/campaign)
// ─────────────────────────────────────────────────────────────────────────────

model Fund {
  id String @id @default(cuid())

  /// WooCommerce product ID within this org's store
  wcProductId Int?
  /// Custom Plugin campaign ID
  tdfFundId   Int?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  source String @default("woocommerce")

  name             String
  slug             String
  description      String? @db.Text
  shortDescription String? @db.Text
  status           String /// WC status: publish | draft | private | pending

  price        Decimal? @db.Decimal(12, 2)
  regularPrice Decimal? @db.Decimal(12, 2)
  salePrice    Decimal? @db.Decimal(12, 2)
  totalSales   Int      @default(0)

  /// Snapshot of WooCommerce category array: [{id, name, slug}]
  categories Json?
  /// Snapshot of WooCommerce image array: [{id, src, alt}]
  images     Json?
  /// Additional WooCommerce meta fields stored as JSON
  metaData   Json?

  wcCreatedAt DateTime?
  wcUpdatedAt DateTime?
  syncedAt    DateTime  @default(now())

  donations Donation[]

  @@unique([orgId, wcProductId])
  @@unique([orgId, tdfFundId])
  @@index([orgId])
  @@index([orgId, status])
  @@map("funds")
}

// ─────────────────────────────────────────────────────────────────────────────
// DONOR — Mirrors a WooCommerce Customer (or guest)
// ─────────────────────────────────────────────────────────────────────────────

model Donor {
  id String @id @default(cuid())

  /// WooCommerce customer ID; null for guest donors
  wcCustomerId Int?
  /// Custom Plugin donor ID
  tdfDonorId   Int?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  source String @default("woocommerce")

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  username  String?
  avatarUrl String?

  normalizedPhone String?

  /// Full WooCommerce billing address snapshot
  billingAddress  Json?
  /// Full WooCommerce shipping address snapshot
  shippingAddress Json?

  totalSpent       Decimal @default(0) @db.Decimal(12, 2)
  ordersCount      Int     @default(0)
  isPayingCustomer Boolean @default(false)

  lastDonationAt DateTime?
  wcDateCreated  DateTime?
  wcDateModified DateTime?
  syncedAt       DateTime  @default(now())

  donations Donation[]

  // Keep unique constraint for WooCommerce customer sync
  @@unique([orgId, wcCustomerId])
  @@unique([orgId, tdfDonorId])
  @@index([orgId])
  @@index([orgId, email])
  @@index([orgId, normalizedPhone])
  @@index([orgId, lastDonationAt])
  @@map("donors")
}

// ─────────────────────────────────────────────────────────────────────────────
// DONATION — Mirrors a WooCommerce Order
// ─────────────────────────────────────────────────────────────────────────────

model Donation {
  id String @id @default(cuid())

  /// WooCommerce order ID
  wcOrderId     Int?
  /// Custom Plugin donation ID
  tdfDonationId Int?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  source String @default("woocommerce")

  /// Nullable: guest donors may not map to a Donor record
  donorId String?
  donor   Donor?  @relation(fields: [donorId], references: [id], onDelete: SetNull)

  /// Nullable: fund may have been deleted from WooCommerce after the order
  fundId String?
  fund   Fund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)

  status   DonationStatus @default(PENDING)
  currency String         @default("USD")

  total         Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)
  totalTax      Decimal @default(0) @db.Decimal(12, 2)
  totalShipping Decimal @default(0) @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2)

  paymentMethod      String?
  paymentMethodTitle String?
  transactionId      String?

  customerNote String? @db.Text

  /// Billing address snapshot at time of donation
  billingSnapshot Json?
  /// Full WooCommerce line_items array snapshot
  lineItems       Json

  wcDateCreated   DateTime?
  wcDateModified  DateTime?
  wcDateCompleted DateTime?
  wcDatePaid      DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  syncedAt DateTime @default(now())

  @@unique([orgId, wcOrderId])
  @@unique([orgId, tdfDonationId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, wcDatePaid])
  @@index([orgId, status, wcDatePaid])
  @@index([donorId])
  @@index([fundId])
  @@map("donations")
}

// ─────────────────────────────────────────────────────────────────────────────
// SYNC LOG — Audit trail for every WooCommerce sync run
// ─────────────────────────────────────────────────────────────────────────────

model SyncLog {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  status      SyncStatus
  triggeredBy SyncTrigger

  // Fund (Product) sync counts
  fundsTotal   Int @default(0)
  fundsAdded   Int @default(0)
  fundsUpdated Int @default(0)

  // Donor (Customer) sync counts
  donorsTotal   Int @default(0)
  donorsAdded   Int @default(0)
  donorsUpdated Int @default(0)

  // Donation (Order) sync counts
  donationsTotal   Int @default(0)
  donationsAdded   Int @default(0)
  donationsUpdated Int @default(0)

  error       String?   @db.Text /// Serialized error if status = FAILED
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([orgId])
  @@index([orgId, startedAt])
  @@map("sync_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// FACEBOOK ADS LEDGER — prepaid credits and daily spend, separate from donations
// ─────────────────────────────────────────────────────────────────────────────

model AdLedgerEntry {
  id String @id @default(cuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  type     AdLedgerEntryType
  status   AdLedgerEntryStatus @default(POSTED)
  source   AdLedgerEntrySource @default(MANUAL)
  amount   Decimal             @db.Decimal(12, 2)
  currency String              @default("BDT")

  /// Calendar day in Asia/Dhaka, stored as a date-only value.
  entryDate    DateTime @db.Date
  campaignName String?
  reference    String?
  note         String?  @db.Text

  importBatchId String?
  importBatch   AdSpendImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("AdLedgerEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  voidedAt   DateTime?
  voidReason String?  @db.Text

  @@index([orgId, entryDate, status])
  @@index([orgId, type, entryDate])
  @@index([importBatchId])
  @@map("ad_ledger_entries")
}

model AdSpendImportBatch {
  id String @id @default(cuid())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  fileName  String
  fileHash  String
  rowCount  Int      @default(0)
  createdAt DateTime @default(now())

  importedById String?
  importedBy   User? @relation("AdSpendImportBatchImporter", fields: [importedById], references: [id], onDelete: SetNull)

  entries AdLedgerEntry[]

  @@unique([orgId, fileHash])
  @@index([orgId, createdAt])
  @@map("ad_spend_import_batches")
}

// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// NEXTAUTH ADAPTER TABLES
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
